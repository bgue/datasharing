{
 "schema_version": "1.0",
 "id": "rec_or_room",
 "name": "Operating room fit-out",
 "summary": "Build an operating room as a repeating recipe: ICRA, framing, services, gas test, fire-stopping, sealed boarding and ceilings, hygienic floor, theatre fixtures, air balance, pressure test, clean and handover.",
 "sector": "healthcare",
 "tags": [
  "clinical",
  "ventilation",
  "icra",
  "medical_gas"
 ],
 "applies_to": {
  "zone_tags_any": [
   "or_room"
  ],
  "name_regex": "(?i)(theatre|operating|\\bOR\\b)",
  "keywords": [
   "operating room",
   "theatre",
   "or room"
  ]
 },
 "prerequisites": {
  "equipment": [
   "lift"
  ],
  "site": [
   "access_road"
  ],
  "permits": [
   "hot_work",
   "icra"
  ],
  "information": [
   "room data sheet",
   "ventilation design",
   "medical gas layout"
  ]
 },
 "steps": [
  {
   "ref": "GEN-ICRA-SETUP",
   "hold_point": "icra",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "GEN-PERMIT-HOT",
   "virtual": true,
   "marker": "permit",
   "note": "Brazing of medical gas pipework"
  },
  {
   "ref": "ARC-WALL-FRAME",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "MEP-DUCT-INSTALL",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "PLB-PIPE-INSTALL",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "MED-GAS-PIPE-INSTALL",
   "optional": true,
   "quantity": {
    "basis": "length_m",
    "value": 20
   }
  },
  {
   "ref": "MED-GAS-TEST",
   "hold_point": "medical_gas",
   "optional": true,
   "quantity": {
    "basis": "length_m",
    "value": 20
   }
  },
  {
   "ref": "FIR-STOP-INSTALL",
   "hold_point": "fire",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "ELE-CABLE-PULL",
   "hold_point": "electrical",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "ARC-WALL-BOARD",
   "from_element": "zone",
   "note": "Sealed, smooth walls",
   "optional": true
  },
  {
   "ref": "ARC-CEILING-CLOSE",
   "from_element": "zone",
   "note": "Sealed hygienic ceiling"
  },
  {
   "ref": "ARC-FLOOR-FINISH",
   "from_element": "zone",
   "note": "Welded, coved flooring",
   "optional": true
  },
  {
   "ref": "ARC-DOOR-INSTALL",
   "from_element": "host",
   "optional": true
  },
  {
   "ref": "ELE-LIGHT-INSTALL",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "MEP-DIFFUSER-SET",
   "from_element": "zone",
   "note": "HEPA terminals",
   "optional": true
  },
  {
   "ref": "MED-EQUIP-INSTALL",
   "from_element": "zone",
   "note": "Pendants and theatre lights",
   "optional": true
  },
  {
   "ref": "CX-AIR-BALANCE",
   "optional": true
  },
  {
   "ref": "CX-PRESSURE-TEST",
   "hold_point": "mechanical",
   "from_element": "zone"
  },
  {
   "ref": "GEN-HEPA-CLEAN",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "GEN-ICRA-CLOSEOUT",
   "hold_point": "icra",
   "from_element": "zone",
   "optional": true
  }
 ],
 "logic": [
  {
   "after": "MED-GAS-TEST",
   "before": "ARC-WALL-BOARD",
   "reason": "Walls cannot close over untested gas pipe"
  },
  {
   "after": "FIR-STOP-INSTALL",
   "before": "ARC-WALL-BOARD",
   "reason": "Fire-stopping inspected before boarding"
  },
  {
   "after": "ARC-CEILING-CLOSE",
   "before": "ARC-FLOOR-FINISH",
   "reason": "Ceilings before floors"
  }
 ],
 "checks": [
  "ICRA barrier verified before dusty work",
  "Medical gas pressure test before wall closure",
  "Fire-stopping inspected before boarding",
  "Air balance and pressure regime test before clean",
  "ICRA clearance before barrier removal"
 ],
 "references": [
  "Infection prevention and control guidance for construction and renovation in healthcare facilities (ICRA)",
  "Medical gas pipeline system guidance (design, installation, testing and verification)",
  "Healthcare ventilation guidance (air change rates, pressure regimes, validation)",
  "Fire safety guidance for healthcare buildings (compartmentation and fire-stopping)"
 ],
 "typical_duration_weeks": [
  10,
  20
 ]
}
