{
 "schema_version": "1.0",
 "id": "rec_pressure_room",
 "name": "Pressure-controlled room (isolation or protective environment)",
 "summary": "Seal the envelope, install ducts and HEPA terminals, floors and doors, balance, test the pressure differential and hand over after ICRA clearance.",
 "sector": "healthcare",
 "tags": [
  "pressure_room",
  "ventilation",
  "icra"
 ],
 "applies_to": {
  "zone_tags_any": [
   "pressure_room"
  ],
  "ifc_class": [
   "IfcAirTerminal"
  ],
  "keywords": [
   "pressure room",
   "isolation room",
   "protective environment",
   "negative pressure",
   "positive pressure"
  ]
 },
 "prerequisites": {
  "equipment": [
   "lift"
  ],
  "site": [
   "access_road"
  ],
  "permits": [
   "icra"
  ],
  "information": [
   "ventilation design",
   "pressure regime schedule"
  ]
 },
 "steps": [
  {
   "ref": "GEN-ICRA-SETUP",
   "hold_point": "icra",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "ARC-WALL-FRAME",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "MEP-DUCT-INSTALL",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "FIR-STOP-INSTALL",
   "hold_point": "fire",
   "from_element": "zone",
   "note": "Seal every penetration for air tightness",
   "optional": true
  },
  {
   "ref": "ARC-WALL-BOARD",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "ARC-CEILING-CLOSE",
   "from_element": "zone",
   "note": "Sealed ceiling"
  },
  {
   "ref": "ARC-FLOOR-FINISH",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "ARC-DOOR-INSTALL",
   "from_element": "host",
   "note": "Sealed doors with closers",
   "optional": true
  },
  {
   "ref": "MEP-DIFFUSER-SET",
   "from_element": "zone",
   "note": "HEPA terminals",
   "optional": true
  },
  {
   "ref": "GEN-PRECOMM-CHECK",
   "virtual": true,
   "marker": "test",
   "note": "Monitor and alarm check"
  },
  {
   "ref": "CX-AIR-BALANCE",
   "optional": true
  },
  {
   "ref": "CX-PRESSURE-TEST",
   "hold_point": "mechanical",
   "from_element": "zone",
   "note": "Pressure differential with doors closed and open"
  },
  {
   "ref": "GEN-HEPA-CLEAN",
   "from_element": "zone",
   "optional": true
  },
  {
   "ref": "GEN-ICRA-CLOSEOUT",
   "hold_point": "icra",
   "from_element": "zone",
   "optional": true
  }
 ],
 "logic": [
  {
   "after": "FIR-STOP-INSTALL",
   "before": "ARC-WALL-BOARD",
   "reason": "Seal before closing"
  },
  {
   "after": "CX-AIR-BALANCE",
   "before": "CX-PRESSURE-TEST",
   "reason": "Balance first, then verify differential"
  }
 ],
 "checks": [
  "Smoke test for envelope leakage",
  "Pressure differential at design airflow",
  "Alarm and monitor function test"
 ],
 "references": [
  "Healthcare ventilation guidance (air change rates, pressure regimes, validation)",
  "Infection prevention and control guidance for construction and renovation in healthcare facilities (ICRA)"
 ],
 "typical_duration_weeks": [
  8,
  16
 ]
}
