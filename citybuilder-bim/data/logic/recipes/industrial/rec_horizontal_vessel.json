   "quantity": {
    "basis": "weight_t",
    "value": 1
   }
  },
  {
   "ref": "STR-FOOT-POUR",
   "hold_point": "structural",
   "from_element": "foundation",
   "note": "Saddle footings",
   "optional": true,
   "quantity": {
    "basis": "volume_m3",
    "value": 6
   }
  },
  {
   "ref": "GEN-CURING-WATCH",
