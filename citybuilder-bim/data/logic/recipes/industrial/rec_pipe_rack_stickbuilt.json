 "sector": "industrial",
 "tags": [
  "pipe_rack",
  "stick_built",
  "scaffold"
 ],
 "applies_to": {
  "ifc_class": [
   "IfcMember",
   "IfcColumn",
   "IfcBeam"
  ],
  "name_regex": "(?i)(rack|pipe.?bridge|sleeper)",
  "visual_kit": [
   "rack"
  ],
  "zone_tags_any": [
   "pipe_rack"
  ],
  "keywords": [
   "stick built rack",
   "pipe rack"
  ]
 },
 "prerequisites": {
  "equipment": [
   "mobile_crane"
  ],
  "site": [
   "access_road",
   "laydown>=3"
  ],
  "permits": [
   "hot_work",
   "work_at_height"
  ],
  "information": [
   "rack drawings",
   "weld procedure"
  ]
 },
 "steps": [
  {
   "ref": "GEN-SURVEY-SETOUT",
   "virtual": true,
   "marker": "survey"
  },
  {
   "ref": "GEN-PERMIT-HOT",
   "virtual": true,
   "marker": "permit"
  },
  {
   "ref": "GEN-LIFT-PLAN",
   "virtual": true,
   "marker": "lift_plan"
  },
  {
   "ref": "STR-FOOT-REBAR",
   "from_element": "foundation",
   "optional": true,
   "quantity": {
    "basis": "weight_t",
    "value": 1
   }
  },
  {
   "ref": "STR-FOOT-POUR",
   "hold_point": "structural",
   "from_element": "foundation",
   "optional": true,
   "quantity": {
    "basis": "volume_m3",
    "value": 6
   }
  },
  {
   "ref": "GEN-ANCHOR-SURVEY",
   "virtual": true,
   "marker": "survey"
  },
  {
   "ref": "GEN-SCAFFOLD-ERECT",
   "virtual": true,
   "marker": "scaffold"
  },
  {
   "ref": "STR-RACK-ERECT",
   "optional": true
  },
  {
   "ref": "STR-RACK-CONN",
   "hold_point": "welding",
   "optional": true
  },
  {
   "ref": "PIP-SPOOL-LAY",
   "optional": true,
   "quantity": {
    "basis": "length_m",
    "value": 20
   }
  },
  {
   "ref": "PIP-FITTING-INSTALL"
  },
  {
   "ref": "GEN-HYDROTEST",
   "virtual": true,
   "marker": "test",
   "hold_point": "pressure_test"
  },
  {
   "ref": "ELE-TRAY-INSTALL",
   "optional": true,
   "quantity": {
    "basis": "length_m",
    "value": 20
   }
  },
  {
   "ref": "ELE-CABLE-PULL",
   "optional": true,
   "quantity": {
    "basis": "length_m",
    "value": 20
   }
  },
  {
   "ref": "INS-PIPE-INSULATE",
   "optional": true,
   "quantity": {
    "basis": "length_m",
    "value": 20
   }
  },
  {
   "ref": "GEN-SCAFFOLD-DISMANTLE",
   "virtual": true,
   "marker": "scaffold"
  },
  {
   "ref": "CX-PIPE-FLUSH",
   "optional": true,
   "quantity": {
    "basis": "length_m",
    "value": 20
   }
  }
 ],
 "logic": [
  {
   "after": "STR-FOOT-POUR",
   "before": "STR-RACK-ERECT",
   "lag_days": 7,
   "reason": "Footing strength"
  },
  {
   "after": "INS-PIPE-INSULATE",
   "before": "GEN-SCAFFOLD-DISMANTLE",
   "reason": "Scaffold stays until insulation is done"
  }
 ],
 "checks": [
  "Hot work permits for every welding shift",
  "Scaffold inspected before each shift (tag system)",
  "Weld NDT before spool loading",
  "Hydrotest before insulation"
 ],
 "references": [
  "National lifting operations guidance (lift planning and appointed person duties)",
  "Welding and non-destructive testing guidance for structural steelwork and piping",
  "Process piping guidance (installation, pressure testing, flushing and reinstatement)"
 ],
 "typical_duration_weeks": [
  12,
  24
 ]
}
