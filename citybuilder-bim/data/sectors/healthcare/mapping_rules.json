  {
   "id": "R-icra-zone",
   "description": "Zones next to the live hospital get an ICRA barrier, HEPA clean and clearance. Not chained: dependencies come from step predecessors (same_zone).",
   "priority": 400,
   "match": {
    "ifc_class": [
     "IfcSlab"
    ],
    "zone_tags_any": [
     "occupied_adjacent"
    ]
   },
   "steps": [
    {
     "step": "GEN-ICRA-SETUP",
     "quantity": "count",
     "min_quantity": 1
    },
    {
     "step": "GEN-HEPA-CLEAN",
     "quantity": "area_m2",
     "min_quantity": 1
    },
    {
     "step": "GEN-ICRA-CLOSEOUT",
     "quantity": "count",
     "min_quantity": 1
    }
   ],
   "continue": true,
   "chain": false,
   "visual": "slab",
   "recipe": "rec_icra_containment"
  },
