 "tutorial_hints": [
  {
   "week": 0,
   "text": "Welcome, planner. The grey cells on the east edge are the live hospital. Anything noisy or dusty next to it needs an ICRA barrier first."
  },
  {
   "week": 0,
   "text": "Place a haul road from the gate, a crane pad, and an ICRA barrier along the hospital edge. Then hire a concrete crew and release the footings."
  },
  {
   "week": 1,
   "text": "Open the procurement panel: MRI takes 26 weeks, CT 20, chillers 16, switchgear 24, the transformer 40. Order in week one."
  },
  {
   "week": 4,
   "text": "Each floor goes columns, formwork, rebar, pour, then strike 7 days later. Columns need the slab below; services below wait for the strike above."
  },
  {
   "week": 9,
   "text": "External walls wait for the slab above. Close the building in before MEP rough-in: the weathertight gate enforces it."
  },
  {
   "week": 14,
   "text": "Dense MEP: ducts, pipes, trays, sprinklers and gas. Release floor by floor. Too many trades in one zone means trade stacking."
  },
  {
   "week": 18,
   "text": "Medical gas pipes must pass a pressure test before walls are boarded and long before any medical equipment goes in."
  },
  {
   "week": 22,
   "text": "Ceiling close-out: every rough-in inspection in the zone must pass before boarding and ceilings. The gate will block you otherwise."
  },
  {
   "week": 28,
   "text": "Install medical equipment into finished rooms. Then commission: air balance, fire test, power and medical gas certification."
  },
  {
   "week": 34,
   "text": "Finish with ICRA close-out: HEPA clean and clearance before the barrier comes down, then room handover documents."
  }
 ]
}
