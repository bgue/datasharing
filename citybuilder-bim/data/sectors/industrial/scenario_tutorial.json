 "tutorial_hints": [
  {
   "week": 0,
   "text": "Welcome, planner. Lay a haul road from the south gate to the ring road around the building. No road means no access, and no access means no work."
  },
  {
   "week": 0,
   "text": "Hire a civil crew and release the setting-out and pad excavations. Start with the equipment pads: they gate the heavy lifts."
  },
  {
   "week": 1,
   "text": "Open the procurement panel now. Steel takes 8 weeks, modules 30 weeks and the transformer 40. Order early or the install steps will stall."
  },
  {
   "week": 4,
   "text": "Pour footings and pads, then request the structural inspection. Pads need a few days of cure time before a module can land on them."
  },
  {
   "week": 7,
   "text": "Place a crane pad where its reach covers both the steel frame and the module area. The crawler crane reaches farther but costs much more per week."
  },
  {
   "week": 11,
   "text": "Steel is a heavy lift and wind can stop it. Keep a second work front available so crews are not idle on a windy week."
  },
  {
   "week": 15,
   "text": "The pipe rack is linear: foundations, steel, spools. Work it bay by bay to avoid stacking three trades in one zone."
  },
  {
   "week": 21,
   "text": "Every pipe must pass its hydrotest before insulation. The gate holds insulation back until the pressure tests are signed off."
  },
  {
   "week": 27,
   "text": "Pre-commissioning gate: loop checks, flushing and cable tests. Commissioning crews are scarce, so book them before you need them."
  },
  {
   "week": 33,
   "text": "Commissioning is by system, not by area. Energise power first, then start up process, then balance air, then compile handover documents."
  }
 ],
