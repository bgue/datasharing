  {
   "id": "R-tm-live-linear",
   "description": "Utility and duct works in a live-traffic zone require stage 1 traffic management first (separate task, gated by same_zone predecessors).",
   "priority": 400,
   "match": {
    "ifc_class": [
     "IfcPipeSegment",
     "IfcCableCarrierSegment"
    ],
    "zone_tags_any": [
     "live_traffic"
    ]
   },
   "steps": [
    {
     "step": "CIV-TM-STAGE1",
     "quantity": "length_m",
     "min_quantity": 60
    }
   ],
   "continue": true,
   "chain": false,
   "visual": "pipe"
  },
