 "tutorial_hints": [
  {
   "week": 0,
   "text": "Welcome, planner. This is a linear job: each zone is a stretch of chainage. Lay a haul road from the west gate along the working strip."
  },
  {
   "week": 0,
   "text": "Traffic first. Stage 1 lane closure and cones must be in place before utilities or earthworks start in zones tagged live traffic."
  },
  {
   "week": 2,
   "text": "Divert and prove utilities before you dig. Skipping the diversion invites a utility strike."
  },
  {
   "week": 4,
   "text": "Cut feeds fill. Once cutting has started anywhere, fill can follow five days later. Short haul distances keep productivity up."
  },
  {
   "week": 7,
   "text": "Order the long-lead bridge items now: bearings take 10 weeks and precast beams 8."
  },
  {
   "week": 11,
   "text": "Bridge order: piles, pile caps, piers, bearings, beams, deck, barriers. Each step waits for the one before it."
  },
  {
   "week": 15,
   "text": "Beam lifts need the crawler crane and a night closure. They are the riskiest steps on the job. Keep the zone clear of other crews."
  },
  {
   "week": 19,
   "text": "Drainage must be tested and backfilled before pavement. The gates hold pavement back until traffic stage 2 is in place."
  },
  {
   "week": 25,
   "text": "Asphalt hates cold and rain. Check the monthly weather factors and schedule paving for the warmer months."
  },
  {
   "week": 30,
   "text": "Finish with markings, signs and lighting, then compile the handover pack."
  }
 ],
