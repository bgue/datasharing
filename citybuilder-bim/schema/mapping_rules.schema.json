{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sitebuilder.dev/schema/mapping_rules.schema.json",
  "title": "BIM element to construction step mapping rules",
  "type": "object",
  "required": [
    "schema_version",
    "sector",
    "rules",
    "default"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "sector": {
      "$ref": "common.schema.json#/$defs/sector"
    },
    "step_library": {
      "type": "string",
      "description": "Relative path to the step library this targets"
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "default": {
      "type": "object",
      "required": [
        "steps"
      ],
      "properties": {
        "steps": {
          "$ref": "#/$defs/step_emits"
        },
        "visual": {
          "type": "string"
        }
      }
    }
  },
  "$defs": {
    "step_emits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "step",
          "quantity"
        ],
        "properties": {
          "step": {
            "$ref": "common.schema.json#/$defs/step_id"
          },
          "quantity": {
            "$ref": "common.schema.json#/$defs/quantity_basis"
          },
          "quantity_factor": {
            "type": "number",
            "exclusiveMinimum": 0,
            "default": 1.0
          },
          "unit_override": {
            "$ref": "common.schema.json#/$defs/unit"
          },
          "lag_days": {
            "type": "integer",
            "default": 0,
            "description": "Lag from previous step in this chain"
          },
          "min_quantity": {
            "type": "number",
            "minimum": 0,
            "default": 0
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "required": [
        "id",
        "priority",
        "match"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^R-[a-z0-9-]+$"
        },
        "description": {
          "type": "string"
        },
        "priority": {
          "type": "integer"
        },
        "continue": {
          "type": "boolean",
          "default": false
        },
        "chain": {
          "type": "boolean",
          "default": true
        },
        "visual": {
          "type": "string",
          "description": "Overrides element.visual for the game"
        },
        "system_prefix": {
          "type": "string",
          "description": "Only match elements whose system_id starts with this"
        },
        "match": {
          "type": "object",
          "properties": {
            "ifc_class": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "predefined_type": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "name_regex": {
              "type": "string"
            },
            "material_regex": {
              "type": "string"
            },
            "storey_index_min": {
              "type": "integer"
            },
            "storey_index_max": {
              "type": "integer"
            },
            "zone_tags_any": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "properties": {
              "type": "object",
              "description": "Each key must equal the given value on element.properties (string, number or boolean)",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            },
            "properties_present": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "quantity_min": {
              "type": "object",
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "additionalProperties": false
        },
        "steps": {
          "$ref": "#/$defs/step_emits"
        },
        "recipe": {
          "type": "string",
          "pattern": "^rec_[a-z0-9_]+$",
          "description": "Emit this recipe's steps for the matched element instead of/in addition to steps"
        },
        "visual_kit": {
          "type": "string"
        },
        "anchor": {
          "type": "string",
          "enum": [
            "element",
            "system",
            "zone",
            "cell_group",
            "storey",
            "project"
          ],
          "default": "element",
          "description": "How often a recipe on this rule expands: once per matched element, once per system_id, once per zone, once per contiguous cell group of matched elements, once per storey, or once for the project"
        }
      }
    }
  }
}
